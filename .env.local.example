# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI
GOOGLE_AI_API_KEY=your-google-ai-api-key
GEMINI_VISION_MODEL=gemini-3.1-flash-lite-preview
GEMINI_QUERY_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview

# ImageKit
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-id
IMAGEKIT_PUBLIC_KEY=public_your-public-key
IMAGEKIT_PRIVATE_KEY=private_your-private-key

# Inngest (use "local" for local dev, real keys for production)
INNGEST_EVENT_KEY=local
INNGEST_SIGNING_KEY=local
